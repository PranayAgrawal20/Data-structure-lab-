
#include <iostream>
using namespace std;

int main()
{
    int arr[7] = {10, 20, 30, 40, 50, 60, 70};

    int key;
    cout << "Enter element to search: ";
    cin >> key;

    int low = 0;
    int high = 6;
    int found = -1;

    while(low <= high)
    {
        int mid = low + (high - low) / 2;

        if(arr[mid] == key)
        {
            found = mid;
            break;
        }
        else if(arr[mid] < key)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    if(found != -1)
    {
        cout << "Element found at index: " << found;
    }
    else
    {
        cout << "Element not found";
    }

    return 0;
}
