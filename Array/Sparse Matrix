
#include <iostream>
using namespace std;

int main()
{
    int arr[10][10];
    int sparse[101][3];

    int rows, cols;
    int k = 1;

    cout << "Enter rows: ";
    cin >> rows;

    cout << "Enter columns: ";
    cin >> cols;

    cout << "Enter matrix elements:\n";

    for(int i = 0; i < rows; i++)
    {
        for(int j = 0; j < cols; j++)
        {
            cin >> arr[i][j];
        }
    }

    sparse[0][0] = rows;
    sparse[0][1] = cols;

    for(int i = 0; i < rows; i++)
    {
        for(int j = 0; j < cols; j++)
        {
            if(arr[i][j] != 0)
            {
                sparse[k][0] = i;
                sparse[k][1] = j;
                sparse[k][2] = arr[i][j];

                k++;
            }
        }
    }

    sparse[0][2] = k - 1;

    cout << "\nOriginal Matrix:\n";

    for(int i = 0; i < rows; i++)
    {
        for(int j = 0; j < cols; j++)
        {
            cout << arr[i][j] << " ";
        }
        cout << endl;
    }

    cout << "\nSparse Matrix (Triplet Representation):\n";

    cout << "Row\tColumn\tValue\n";

    for(int i = 0; i < k; i++)
    {
        for(int j = 0; j < 3; j++)
        {
            cout << sparse[i][j] << "\t";
        }
        cout << endl;
    }

    cout << "\nTotal non-zero elements: " << k - 1;

    return 0;
}
