
#include <iostream>
using namespace std;

int main()
{
    int A[10][10], B[10][10], C[10][10];

    int r1, c1, r2, c2;
    int choice;

    cout << "Enter rows and columns of Matrix A: ";
    cin >> r1 >> c1;

    cout << "Enter Matrix A elements:\n";

    for(int i = 0; i < r1; i++)
    {
        for(int j = 0; j < c1; j++)
        {
            cin >> A[i][j];
        }
    }

    cout << "Enter rows and columns of Matrix B: ";
    cin >> r2 >> c2;

    cout << "Enter Matrix B elements:\n";

    for(int i = 0; i < r2; i++)
    {
        for(int j = 0; j < c2; j++)
        {
            cin >> B[i][j];
        }
    }

    cout << "\n--- MATRIX CALCULATOR ---";
    cout << "\n1. Addition";
    cout << "\n2. Subtraction";
    cout << "\n3. Multiplication";
    cout << "\n4. Transpose of Matrix A";

    cout << "\nEnter your choice: ";
    cin >> choice;

    switch(choice)
    {
        case 1:

            if(r1 != r2 || c1 != c2)
            {
                cout << "Addition not possible!";
                break;
            }

            for(int i = 0; i < r1; i++)
            {
                for(int j = 0; j < c1; j++)
                {
                    C[i][j] = A[i][j] + B[i][j];
                }
            }

            cout << "Addition Result:\n";

            for(int i = 0; i < r1; i++)
            {
                for(int j = 0; j < c1; j++)
                {
                    cout << C[i][j] << " ";
                }
                cout << endl;
            }

            break;

        case 2:

            if(r1 != r2 || c1 != c2)
            {
                cout << "Subtraction not possible!";
                break;
            }

            for(int i = 0; i < r1; i++)
            {
                for(int j = 0; j < c1; j++)
                {
                    C[i][j] = A[i][j] - B[i][j];
                }
            }

            cout << "Subtraction Result:\n";

            for(int i = 0; i < r1; i++)
            {
                for(int j = 0; j < c1; j++)
                {
                    cout << C[i][j] << " ";
                }
                cout << endl;
            }

            break;

        case 3:

            if(c1 != r2)
            {
                cout << "Multiplication not possible!";
                break;
            }

            for(int i = 0; i < r1; i++)
            {
                for(int j = 0; j < c2; j++)
                {
                    C[i][j] = 0;

                    for(int k = 0; k < c1; k++)
                    {
                        C[i][j] += A[i][k] * B[k][j];
                    }
                }
            }

            cout << "Multiplication Result:\n";

            for(int i = 0; i < r1; i++)
            {
                for(int j = 0; j < c2; j++)
                {
                    cout << C[i][j] << " ";
                }
                cout << endl;
            }

            break;

        case 4:

            cout << "Transpose of Matrix A:\n";

            for(int j = 0; j < c1; j++)
            {
                for(int i = 0; i < r1; i++)
                {
                    cout << A[i][j] << " ";
                }
                cout << endl;
            }

            break;

        default:
            cout << "Invalid choice!";
    }

    return 0;
}
