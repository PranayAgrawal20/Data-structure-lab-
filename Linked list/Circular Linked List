
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

Node* head = NULL;

// Insert at beginning
void insertBeginning(int value) {
    Node* newNode = new Node();

    newNode->data = value;

    if (head == NULL) {
        head = newNode;
        newNode->next = head;
    }
    else {
        Node* temp = head;

        while (temp->next != head) {
            temp = temp->next;
        }

        newNode->next = head;
        temp->next = newNode;
        head = newNode;
    }

    cout << "Node inserted successfully!\n";
}

// Insert at end
void insertEnd(int value) {
    Node* newNode = new Node();

    newNode->data = value;

    if (head == NULL) {
        head = newNode;
        newNode->next = head;
    }
    else {
        Node* temp = head;

        while (temp->next != head) {
            temp = temp->next;
        }

        temp->next = newNode;
        newNode->next = head;
    }

    cout << "Node inserted successfully!\n";
}

// Delete from beginning
void deleteBeginning() {
    if (head == NULL) {
        cout << "List is empty!\n";
        return;
    }

    if (head->next == head) {
        delete head;
        head = NULL;
        return;
    }

    Node* temp = head;
    Node* last = head;

    while (last->next != head) {
        last = last->next;
    }

    head = head->next;
    last->next = head;

    delete temp;

    cout << "Node deleted successfully!\n";
}

// Delete from end
void deleteEnd() {
    if (head == NULL) {
        cout << "List is empty!\n";
        return;
    }

    if (head->next == head) {
        delete head;
        head = NULL;
        return;
    }

    Node* temp = head;

    while (temp->next->next != head) {
        temp = temp->next;
    }

    Node* last = temp->next;
    temp->next = head;

    delete last;

    cout << "Node deleted successfully!\n";
}

// Search an element
void searchNode(int value) {
    if (head == NULL) {
        cout << "List is empty!\n";
        return;
    }

    Node* temp = head;
    int position = 1;

    do {
        if (temp->data == value) {
            cout << "Element found at position "
                 << position << endl;
            return;
        }

        temp = temp->next;
        position++;

    } while (temp != head);

    cout << "Element not found!\n";
}

// Display linked list
void display() {
    if (head == NULL) {
        cout << "List is empty!\n";
        return;
    }

    Node* temp = head;

    cout << "Circular Linked List: ";

    do {
        cout << temp->data << " -> ";
        temp = temp->next;
    } while (temp != head);

    cout << "HEAD\n";
}

int main() {
    int choice, value;

    do {
        cout << "\n--- CIRCULAR LINKED LIST ---\n";
        cout << "1. Insert at Beginning\n";
        cout << "2. Insert at End\n";
        cout << "3. Delete from Beginning\n";
        cout << "4. Delete from End\n";
        cout << "5. Search Element\n";
        cout << "6. Display\n";
        cout << "0. Exit\n";

        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter value: ";
                cin >> value;
                insertBeginning(value);
                break;

            case 2:
                cout << "Enter value: ";
                cin >> value;
                insertEnd(value);
                break;

            case 3:
                deleteBeginning();
                break;

            case 4:
                deleteEnd();
                break;

            case 5:
                cout << "Enter value to search: ";
                cin >> value;
                searchNode(value);
                break;

            case 6:
                display();
                break;

            case 0:
                cout << "Exiting program...\n";
                break;

            default:
                cout << "Invalid choice!\n";
        }

    } while (choice != 0);

    // Free remaining nodes
    while (head != NULL) {
        if (head->next == head) {
            delete head;
            head = NULL;
        }
        else {
            Node* temp = head;
            Node* last = head;

            while (last->next != head) {
                last = last->next;
            }

            head = head->next;
            last->next = head;
            delete temp;
        }
    }

    return 0;
}
